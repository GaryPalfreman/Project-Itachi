# Copy to .env. Keep .env on your computer.
# Knowledge access is disabled. Leave these unset to use no personal files.
# ITACHI_ENABLE_KNOWLEDGE=true
# ITACHI_VAULT=/absolute/path/to/a/nonpersonal/knowledge-folder
ITACHI_REASONING_URL=http://127.0.0.1:11434/v1
ITACHI_REASONING_MODEL=llama3.2:3b
# Use a verified *chat* model here. Nemotron-3-Embed-1B is only for search vectors.
# To use official local Qwen as a fallback, run: ollama pull qwen3:4b
ITACHI_REASONING_KEY=
# Optional Llama or another compatible model for quota/context/availability failover.
ITACHI_FALLBACK_URL=
ITACHI_FALLBACK_MODEL=
ITACHI_FALLBACK_KEY=
ITACHI_CODING_URL=
ITACHI_CODING_MODEL=
ITACHI_CODING_KEY=
ITACHI_OPENCLAW_URL=
ITACHI_OPENCLAW_TOKEN=
# TypeSafe JEV System One decision layer. Keep the key server-side.
ITACHI_JEV_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_API_KEY=
# Backward-compatible alias if needed:
# ITACHI_JEV_TOKEN=
ITACHI_PIPER_VOICE=en_US-lessac-medium
ITACHI_WHISPER_MODEL=base.en
ITACHI_TAVILY_KEY=
# Hosted app only: NVIDIA OpenAI-compatible endpoint.
# Keep the API key in Streamlit Secrets, never in source.
#   chat: nvidia/nemotron-3-ultra-550b-a55b
#   embeddings: nvidia/nemotron-3-embed-1b at /v1/embeddings
# ITACHI_NVIDIA_API_KEY=
ITACHI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ITACHI_NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Hosted app only: optionally discover currently free live chat models using your own token.
# ITACHI_HF_TOKEN=
# Hosted app only: other optional, separately authorized free-tier API routes.
# ITACHI_GROQ_API_KEY=
# ITACHI_GEMINI_API_KEY=
# ITACHI_CEREBRAS_API_KEY=
# ITACHI_OPENROUTER_API_KEY=
# Optional cloud replica/recovery for public knowledge. Server key belongs only in GitHub Actions secrets.
# ITACHI_SUPABASE_URL=
# ITACHI_SUPABASE_SERVER_KEY=
# ITACHI_SUPABASE_ANON_KEY=
# Optional tertiary graph-memory replica. Keep server-side only.
# ITACHI_ZEP_API_KEY=
# Optional Google Drive recovery mirror using a dedicated Itachi Google account OAuth grant.
# Recommended: store the complete Google web-client JSON as one server-side secret.
# ITACHI_GOOGLE_OAUTH_JSON=
# API key identifies the Google Cloud project; OAuth is still required for Drive writes.
# ITACHI_GOOGLE_API_KEY=
# ITACHI_GOOGLE_CLIENT_ID=
# ITACHI_GOOGLE_CLIENT_SECRET=
# ITACHI_GOOGLE_REDIRECT_URI=https://project-itachi.streamlit.app
# ITACHI_GOOGLE_REFRESH_TOKEN=
ITACHI_GOOGLE_DRIVE_FOLDER_ID=1fFi6bHUEgjU5cz9M9V8uYaNme1cGgX37
# Optional MEGA recovery mirror. Store these only as server-side/GitHub Actions secrets.
# ITACHI_MEGA_EMAIL=
# ITACHI_MEGA_PASSWORD=
# Optional ordered model chain (1–5 OpenAI-compatible endpoints); overrides reasoning/fallback:
# ITACHI_MODEL_ROUTES_JSON=[{"name":"ollama","url":"http://127.0.0.1:11434/v1","model":"llama3.2:3b"}]
